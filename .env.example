# Kopiere diese Datei nach .env und trage deine Werte ein. .env kommt NIE ins Repository.

# --- E-Mail -------------------------------------------------------------
# Anbieter: resend (empfohlen, kostenlos) | smtp | none
MAIL_PROVIDER=none
MAIL_TO=gabriel.anter123@outlook.com
# Resend: kostenlosen Account mit genau dieser Outlook-Adresse anlegen (resend.com),
# API-Key erstellen (Sending access) und hier eintragen. Absender onboarding@resend.dev
# darf ohne eigene Domain nur an die Account-Adresse senden – das passt hier.
RESEND_API_KEY=
MAIL_FROM=FC27 Tracker <onboarding@resend.dev>
# SMTP (z. B. Gmail mit App-Passwort: smtp.gmail.com / 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Mails einzeln ein-/ausschalten
MAIL_SIGNALS_ENABLED=true
MAIL_HOURLY_ENABLED=true
MAIL_DAILY_CAP=90

# --- Preisquelle ----------------------------------------------------------
# Nur nötig, wenn collector/sources/README.md einen API-Key verlangt
FUTDB_API_KEY=

# --- Sonstiges ------------------------------------------------------------
DASHBOARD_URL=https://fc27-markt-tracker.vercel.app
DATA_PUBLISH_ENABLED=true

# --- Creator-Quellen (optional) --------------------------------------------
# YouTube Data API (kostenlos, Google-Cloud-Projekt): erkennt, wenn ein Creator LIVE ist
YOUTUBE_API_KEY=
# Eigener Discord-Bot in DEINEM eigenen Server (siehe STATUS.md): liest Kanäle, denen du folgst
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=
DISCORD_GUILD_ID=
DISCORD_CREATOR_ID=fifallstars
